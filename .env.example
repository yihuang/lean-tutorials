# Copy to .env and fill in:  cp .env.example .env
#
# Required by `npm run deploy` (wrangler pages deploy) and by anything else that
# talks to Cloudflare. CI does not use this file — it reads the same values from
# repository secrets.
#
# Token permissions: Account → Cloudflare Pages → Edit.
# Account id: `npx wrangler@4 whoami` prints it, or the URL in the dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
