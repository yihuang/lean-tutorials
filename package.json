{
  "name": "lean-tutorials",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive, mobile-friendly Lean 4 tutorials that run the real Lean kernel in the browser via WebAssembly.",
  "scripts": {
    "dev": "node scripts/serve.mjs --dir site --port 8788",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs --dir dist --port 8788",
    "deploy": "node scripts/build.mjs && npx wrangler@4 pages deploy dist --project-name lean-tutorials",
    "tunnel": "npx --yes cloudflared tunnel --url http://localhost:8788",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser-check.mjs",
    "test:layout": "node tests/layout.mjs",
    "test:shots": "npm run build && node tests/screenshots.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
