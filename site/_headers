# Cloudflare Pages response headers.
#
# The Lean runtime is a pthread WebAssembly build with SHARED memory, which
# needs SharedArrayBuffer — only available in a cross-origin-isolated document.
# Both headers must be on the top-level document and on the worker script.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The worker and our own modules are tiny; keep them fresh so a redeploy is
# picked up immediately.
/lean-worker.worker.js
  Cache-Control: public, max-age=300
/src/*
  Cache-Control: public, max-age=300

# The runtime is pinned by `?v=<release>` (see site/src/lean/config.js) and is
# immutable for a given version: the app requests every runtime URL with that
# query, so a version bump changes the URL instead of serving stale bytes.
# This is worth getting right: caching the ~12-16 MB brotli wasm body is what
# makes a repeat visit cost 0 bytes instead of re-downloading 96 MB.
/lean-wasm/lean.js
  Cache-Control: public, max-age=31536000, immutable
/lean-wasm/lean.wasm
  Cache-Control: public, max-age=31536000, immutable
/lean-wasm/core-layer.json
  Cache-Control: public, max-age=31536000, immutable
/lean-wasm/core-lib/*
  Cache-Control: public, max-age=31536000, immutable
/lean-wasm/lean.wasm.part-*
  Cache-Control: public, max-age=31536000, immutable

# Read by the Pages Function, not the browser.
/lean-wasm/runtime.json
  Cache-Control: public, max-age=300
